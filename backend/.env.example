# Copy to backend/.env for local (non-Docker) development.
# docker compose supplies these values itself; see docker-compose.yml.

NODE_ENV=development
PORT=5001

# When running the backend on the host, the database is published on 5434.
DATABASE_URL=postgresql://pickup_user:dev_password@localhost:5434/pickup_counter

# Shared secret for the X-Signature HMAC on POST /payments/webhook.
# Minimum 16 characters; the server refuses to start without it.
WEBHOOK_SECRET=local_assignment_test_secret_change_me

# Seconds a new order holds its stock for.
HOLD_SECONDS=120

# Comma-separated allowed origins, or * for any.
CORS_ORIGIN=*

# Base URL used by the test suite and scripts/send-webhook.ts.
API_BASE_URL=http://localhost:5001

# Enables POST /payments/simulate/:orderId, which the customer screen's
# "Pay with UPI" button uses. Keep it false anywhere real money exists.
ENABLE_PAYMENT_SIMULATION=true
